{
    "name": "gb",
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "turbo": "^2.11.10"
    },
    "private": true,
    "packageManager": "bun@1.3.13",
    "bin": {
        "gb": "./command/index.ts"
    },
    "scripts": {
        "preload": "docker compose -f ./docker-compose.dev.yml up -d --wait && bun run db:setup",
        "postload": "docker compose -f ./docker-compose.dev.yml down",
        "dev": "turbo run dev start:dev",
        "dev:frontend": "turbo run dev --filter=frontend",
        "dev:backend": "turbo run start:dev --filter=backend",
        "dev:mobile": "turbo run dev --filter=mobile",
        "build": "turbo run build",
        "build:frontend": "turbo run build --filter=frontend",
        "build:backend": "turbo run build --filter=backend",
        "build:mobile": "turbo run build --filter=mobile",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "test:frontend": "turbo run test --filter=frontend",
        "test:backend": "turbo run test --filter=backend",
        "preview": "turbo run start:prod",
        "dev:docs": "turbo run dev --filter=docs",
        "build:docs": "turbo run build --filter=docs",
        "db:setup": "bun run --cwd backend db:deploy",
        "db:migrate": "bun run --cwd backend db:migrate",
        "db:deploy": "bun run --cwd backend db:deploy",
        "db:pull": "bun run --cwd backend db:pull",
        "db:studio": "bun run --cwd backend db:studio",
        "seed:demo": "bun run --cwd backend seed:demo",
        "smoke": "bun run --cwd backend smoke"
    },
    "workspaces": ["backend", "frontend", "docs", "mobile"],
    "overrides": {
        "webpackbar": "^7.0.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "fastify": "^5.12.1"
    },
    "dependencies": {
        "typescript": "^6.0.3"
    }
}
