# Copy to `.env` in this folder (infrastructure/.env is gitignored) and fill in.
#   cp env.example .env
#
# These are loaded into all three app replicas via `env_file` in
# docker-compose.yml. PORT, USE_REDIS, REDIS_URL and the CLAMAV_* vars are set
# by Compose itself (per-replica PORT; Redis and ClamAV point at the in-cluster
# `redis` / `clamav` services) and do not belong here.

# --- Supabase ---------------------------------------------------------------
# Production: your hosted project URL + keys.
# Local dev:  point at the Supabase running on your host. From inside a
#             container, localhost is the container, so use host.docker.internal:
#             SUPABASE_URL=http://host.docker.internal:54321
#
# SUPABASE_SERVICE_ROLE_KEY must be the service-role **JWT** (starts `eyJ`).
# A `sb_secret_...` key is accepted by PostgREST but rejected by the edge
# function gateway, which silently takes out the dashboard, class reports,
# attendance summaries and file ingest while everything else looks fine.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUSHABLE_KEY=

# The project's JWT secret (Supabase dashboard → Settings → API → JWT Secret).
# Signs the short-lived tokens the browser and app use to upload directly to
# Storage over TUS. Must belong to the same project as SUPABASE_URL, or Storage
# rejects every upload. Required in production - the app refuses to boot.
SUPABASE_JWT_SECRET=

# --- Secrets (required in production; the app refuses to boot without them) --
# Generate each with:  openssl rand -base64 32
#
# Encrypts chat message content at rest (AES-256-GCM).
CHAT_ENCRYPTION_KEY=
#
# Keys the HMAC that hashes student join codes. Changing it invalidates every
# outstanding code.
STUDENT_CLAIM_CODE_PEPPER=

# --- App --------------------------------------------------------------------
# Cookie domain and allowed CORS origins. Accepts a comma-separated list; the
# first is canonical and is what the cookie domain is derived from.
# e.g. https://app.example.com
FRONTEND_URL=
NODE_ENV=production

# The auth cookie's Domain. The web app's middleware reads this cookie on the
# frontend's own domain, so it has to be visible to both the app and the API.
#
# Left unset it is derived from the last two labels of FRONTEND_URL, which is
# right when the app and API are subdomains of one two-label domain
# (app.example.com + api.example.com -> .example.com). Set it explicitly when:
#   - the API is on a different registrable domain from the app;
#   - the domain has a multi-part suffix (app.example.co.uk would derive
#     .co.uk, a public suffix every browser rejects).
# Set it to `none` for a host-only cookie, when the app and API share one host.
# AUTH_COOKIE_DOMAIN=

# Set to "true" only for a single-tenant dedicated deployment (see code).
DEDICATED_DEPLOYMENT=false
