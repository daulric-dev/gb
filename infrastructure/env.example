# Copy to `.env` in this folder (infrastructure/.env is gitignored) and fill in.
#   cp env.example .env
#
# These are loaded into all three app replicas via `env_file` in
# docker-compose.yml. PORT, USE_REDIS and REDIS_URL are set by Compose itself
# (per-replica PORT; Redis points at the in-cluster `redis` service) and do not
# belong here.

# --- Redis ------------------------------------------------------------------
# Required. Redis is only reachable inside the compose network, but still
# requires a password. Use URL-safe characters: `openssl rand -hex 32`.
REDIS_PASSWORD=

# --- Proxy -------------------------------------------------------------------
# How many proxies sit in front of the API. 1 = the bundled nginx. Add one per
# extra hop (e.g. a CDN in front of nginx) so rate limits see the real client.
# TRUST_PROXY_HOPS=1

# --- Database ---------------------------------------------------------------
# Any PostgreSQL 15+. From inside a container, a database on the host is at
# host.docker.internal. The image applies pending migrations at start
# (`prisma migrate deploy`); set MIGRATE_ON_START=false to run them as a
# separate release step (`docker compose --profile release run --rm migrate`).
DATABASE_URL=
# MIGRATE_ON_START=true
# Only with the commented-out `db` service in docker-compose.yml.
# POSTGRES_PASSWORD=

# --- Object storage (any S3-compatible store) -----------------------------
# AWS S3: leave S3_ENDPOINT empty. R2/B2/MinIO/SeaweedFS: set it.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=gradebook
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Address browsers and phones upload to, when it differs from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
# Public base URL for avatars (e.g. a CDN in front of the bucket).
# S3_PUBLIC_URL=

# --- Email (any SMTP server) -------------------------------------------------
# Either one URL (password URL-encoded)...
SMTP_URL=
# ...or separate fields. Gmail/Outlook/Yahoo: use an app password.
# SMTP_SERVICE=gmail           # gmail | outlook | office365 | yahoo | icloud | zoho
# SMTP_HOST=                   # any other server
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=          # path to a mounted secret instead
MAIL_FROM="GradeBook <no-reply@example.com>"

# --- Single sign-on (optional) - see docs/content/sso.md -----------------------
# SSO_PROVIDERS=google,azure,saml
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SAML_SP_ENTITY_ID=

# --- Secrets (required in production; the app refuses to boot without them) --
# Generate each with:  openssl rand -base64 32
#
# Keys the hashes of sign-in codes and session tokens.
AUTH_SECRET=
#
# Encrypts chat message content at rest (AES-256-GCM).
CHAT_ENCRYPTION_KEY=
#
# Keys the HMAC that hashes student join codes. Changing it invalidates every
# outstanding code.
STUDENT_CLAIM_CODE_PEPPER=

# --- App --------------------------------------------------------------------
# Cookie domain and allowed CORS origins. Accepts a comma-separated list; the
# first is canonical and is what the cookie domain is derived from.
# e.g. https://app.example.com
FRONTEND_URL=
NODE_ENV=production

# The auth cookie's Domain. The web app's middleware reads this cookie on the
# frontend's own domain, so it has to be visible to both the app and the API.
#
# Left unset it is derived from the last two labels of FRONTEND_URL, which is
# right when the app and API are subdomains of one two-label domain
# (app.example.com + api.example.com -> .example.com). Set it explicitly when:
#   - the API is on a different registrable domain from the app;
#   - the domain has a multi-part suffix (app.example.co.uk would derive
#     .co.uk, a public suffix every browser rejects).
# Set it to `none` for a host-only cookie, when the app and API share one host.
# AUTH_COOKIE_DOMAIN=

# Set to "true" only for a single-tenant dedicated deployment (see code).
DEDICATED_DEPLOYMENT=false
