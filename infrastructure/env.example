# Copy to `.env` in this folder (infrastructure/.env is gitignored) and fill in.
#   cp env.example .env
#
# These are loaded into all three app replicas via `env_file` in
# docker-compose.yml. PORT, USE_REDIS and REDIS_URL are set by Compose itself
# (per-replica PORT; Redis points at the in-cluster `redis` service) and do not
# belong here.

# --- Redis ------------------------------------------------------------------
# Required. Redis is only reachable inside the compose network, but still
# requires a password. Use URL-safe characters: `openssl rand -hex 32`.
REDIS_PASSWORD=

# --- Proxy -------------------------------------------------------------------
# How many proxies sit in front of the API. 1 = the bundled nginx. Add one per
# extra hop (e.g. a CDN in front of nginx) so rate limits see the real client.
# TRUST_PROXY_HOPS=1

# --- Database ---------------------------------------------------------------
# Any PostgreSQL 15+. From inside a container, a database on the host is at
# host.docker.internal. The image applies pending migrations at start
# (`prisma migrate deploy`); set MIGRATE_ON_START=false to run them as a
# separate release step (`docker compose --profile release run --rm migrate`).
DATABASE_URL=
# MIGRATE_ON_START=true
# Only with the commented-out `db` service in docker-compose.yml.
# POSTGRES_PASSWORD=

# --- Database backups (required in production) -----------------------------
# The `backup` service dumps the database every day, encrypts it with age and
# uploads it to its own bucket. It refuses to start until the bucket and an
# age public key are set. See BACKUPS.md.
# Use a bucket separate from S3_BUCKET, in the same jurisdiction (EU region for
# EU schools), with versioning + Object Lock and a noncurrent-version expiry.
BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=postgres
# AWS: leave empty. R2/B2/MinIO/SeaweedFS: the endpoint URL.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=us-east-1           # e.g. eu-central-1; "auto" for R2
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_FORCE_PATH_STYLE=          # default: true with an endpoint
# BACKUP_S3_STORAGE_CLASS=             # e.g. STANDARD_IA
# age PUBLIC key(s), comma-separated (age1...). Create the pair OFFLINE with
# `age-keygen`; the private key (AGE-SECRET-KEY-...) must never be on this server.
BACKUP_AGE_RECIPIENTS=
# Defaults to DATABASE_URL. Better: a read-only role (GRANT pg_read_all_data).
# BACKUP_DATABASE_URL=
# Cron, in BACKUP_TZ: the default is 04:00 UTC. Europe/Berlin = 04:00 local.
# BACKUP_SCHEDULE=0 4 * * *
# BACKUP_TZ=UTC
# Dumps older than this are deleted after each successful backup. State the
# maximum time erased data can remain in backups in your privacy notice.
# BACKUP_RETENTION_DAYS=30
# healthchecks.io-style ping URL (/start, success, /fail).
# BACKUP_HEALTHCHECK_URL=
# tmpfs for the encrypted dump during upload; larger than the compressed dump.
# BACKUP_TMPFS_SIZE=2g

# Continuous archiving (point-in-time recovery) for the self-hosted `db` /
# `db-backup` services only. Managed Postgres: enable your provider's PITR.
# WALG_S3_PREFIX=s3://gradebook-backups/wal-g
# WALG_S3_ENDPOINT=
# WALG_S3_REGION=us-east-1
# WALG_S3_ACCESS_KEY_ID=
# WALG_S3_SECRET_ACCESS_KEY=
# WALG_S3_FORCE_PATH_STYLE=            # default: true with an endpoint
# Encrypts WAL and base backups: `openssl rand -hex 32`. Keep an offline copy;
# without it nothing can be restored.
# WALG_LIBSODIUM_KEY=
# WALG_ARCHIVE_TIMEOUT=60              # seconds: about the most data lost
# WALG_BACKUP_SCHEDULE=0 4 * * *       # base backup, in BACKUP_TZ
# WALG_RETAIN_FULL=7                   # base backups kept = days of PITR
# WALG_HEALTHCHECK_URL=

# --- Object storage (any S3-compatible store) -----------------------------
# AWS S3: leave S3_ENDPOINT empty. R2/B2/MinIO/SeaweedFS: set it.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=gradebook
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Address browsers and phones upload to, when it differs from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
# Public base URL for avatars (e.g. a CDN in front of the bucket).
# S3_PUBLIC_URL=

# --- Email (any SMTP server) -------------------------------------------------
# Either one URL (password URL-encoded)...
SMTP_URL=
# ...or separate fields. Gmail/Outlook/Yahoo: use an app password.
# SMTP_SERVICE=gmail           # gmail | outlook | office365 | yahoo | icloud | zoho
# SMTP_HOST=                   # any other server
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=          # path to a mounted secret instead
MAIL_FROM="GradeBook <no-reply@example.com>"

# --- Single sign-on (optional) - see docs/content/sso.md -----------------------
# SSO_PROVIDERS=google,azure,saml
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SAML_SP_ENTITY_ID=

# --- Secrets (required in production; the app refuses to boot without them) --
# Generate each with:  openssl rand -base64 32
#
# Keys the hashes of sign-in codes and session tokens, and signs the
# erasure-log copy in storage (keep it stable: replay checks the signatures).
AUTH_SECRET=
#
# Encrypts chat message content at rest (AES-256-GCM).
CHAT_ENCRYPTION_KEY=
#
# Keys the HMAC that hashes student join codes. Changing it invalidates every
# outstanding code.
STUDENT_CLAIM_CODE_PEPPER=

# --- App --------------------------------------------------------------------
# Cookie domain and allowed CORS origins. Accepts a comma-separated list; the
# first is canonical and is what the cookie domain is derived from.
# e.g. https://app.example.com
FRONTEND_URL=
NODE_ENV=production

# The auth cookie's Domain. The web app's middleware reads this cookie on the
# frontend's own domain, so it has to be visible to both the app and the API.
#
# Left unset it is derived from the last two labels of FRONTEND_URL, which is
# right when the app and API are subdomains of one two-label domain
# (app.example.com + api.example.com -> .example.com). Set it explicitly when:
#   - the API is on a different registrable domain from the app;
#   - the domain has a multi-part suffix (app.example.co.uk would derive
#     .co.uk, a public suffix every browser rejects).
# Set it to `none` for a host-only cookie, when the app and API share one host.
# AUTH_COOKIE_DOMAIN=

# --- Sessions ------------------------------------------------------------------
# A sign-in lasts 30 days after last use, never more than SESSION_MAX_AGE_DAYS
# from sign-in. The token is replaced daily; the replaced one works for
# SESSION_ROTATION_GRACE_SECONDS, after that it counts as copied and the
# session is revoked. SESSION_ALERTS_ENABLED=false stops the new sign-in and
# suspicious-activity emails.
# SESSION_MAX_AGE_DAYS=90
# SESSION_ROTATION_GRACE_SECONDS=120
# SESSION_ALERTS_ENABLED=true

# Set to "true" only for a single-tenant dedicated deployment (see code).
DEDICATED_DEPLOYMENT=false

# --- Data retention and the erasure log (GDPR) -----------------------------
# Soft-deleted files, folders, chat messages and discussion posts are purged
# for good once they have been deleted this many days (a daily job in the
# API, one replica at a time). Per-kind overrides: *_FILES, *_FOLDERS,
# *_CHAT_MESSAGES, *_DISCUSSION_REPLIES. See backend/src/retention.
# RETENTION_PURGE_ENABLED=true
# SOFT_DELETE_RETENTION_DAYS=30
# SOFT_DELETE_RETENTION_DAYS_FILES=30
# RETENTION_PURGE_HOUR_UTC=3          # with a whole-day interval
# RETENTION_PURGE_INTERVAL_HOURS=24
# RETENTION_PURGE_BATCH_SIZE=500
# RETENTION_PURGE_MAX_MINUTES=10
# Every erasure is recorded (ids only) in compliance.erasure_log and copied to
# the app bucket under this prefix, so it survives a database restore; after a
# restore run `bun run erasure:replay --since <backup time>`. `off` disables
# the copy (not recommended). Keep entries longer than any backup can be
# restored from (default 400 days). See backend/src/erasure.
# ERASURE_LOG_S3_PREFIX=erasure-log
# ERASURE_LOG_RETENTION_DAYS=400

# --- Billing (hosted platform only) -----------------------------------------
# Schools pay the platform: a per-user or flat monthly plan after a free trial;
# a lapsed school turns read-only (mutations answer 402). SELF-HOSTED
# DEPLOYMENTS LEAVE BILLING_ENABLED UNSET: billing is off by default - no trial,
# no read-only mode, and every /api/billing and /api/platform route is 404.
# See docs/content/backend/billing.md and docs/content/billing-providers.md.
# BILLING_ENABLED=true
# BILLING_PER_USER_CENTS=500          # per billable user per month
# BILLING_FLAT_CENTS=30000            # flat plan per month, unlimited users
# BILLING_CURRENCY=USD
# BILLING_TRIAL_DAYS=30
# BILLING_GRACE_DAYS=7                # after a missed payment, before read-only
# Operators who get the platform dashboard (verified account emails):
# PLATFORM_ADMIN_EMAILS=ops@example.com
# Web app origin for checkout return URLs (default: first FRONTEND_URL):
# APP_URL=https://app.example.com
#
# Payments go through Stripe (Checkout + Customer Portal). Stripe is offered
# once both keys below are set; with billing on and no keys, schools see
# "payments are not configured yet" and the API logs a startup warning.
# Webhook endpoint: ${API_URL}/api/billing/webhooks/stripe
# Local dev: use test keys and
#   stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed --forward-to localhost:3001/api/billing/webhooks/stripe
# then put the printed whsec_... in STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PER_USER=price_...     # optional: reuse existing prices
# STRIPE_PRICE_FLAT=price_...
