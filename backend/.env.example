# Copy to `backend/.env` for local development. Never commit `.env`.
#   cp .env.example .env
#
# For a containerised deployment, use `infrastructure/env.example` instead -
# Compose sets PORT, USE_REDIS and REDIS_URL itself, so that file omits them.

# --- Auth (required in production) -------------------------------------------
# Keys the hashes of sign-in codes and session tokens. 32+ characters:
#   openssl rand -base64 32
# Changing it signs everyone out, voids outstanding codes and makes the
# erasure-log copy in storage fail its signature check (erasure:replay
# --allow-unsigned reads it anyway).
AUTH_SECRET=

# --- Server -----------------------------------------------------------------
PORT=3001

# Comma-separated list. Every entry is an allowed CORS origin; the first also
# supplies the auth cookie's domain. Include the Expo dev server if you are
# running the mobile app against this backend over the web.
FRONTEND_URL=http://localhost:3000

# Absolute URL of this API, used where a link back to it has to be built.
# API_URL=http://localhost:3001

# `production` marks the auth cookie Secure, so the API must then be HTTPS.
NODE_ENV=development
# Production marks auth cookies Secure (HTTPS only). Running a production build
# locally over http? The mobile app then can't stay signed in; use start:dev,
# or set this to false for local testing only.
# AUTH_COOKIE_SECURE=false

# Sets the auth cookie's Domain. Leave unset locally. In production it must
# cover the API's own host, or the client stores no cookie and every request
# after login is unauthenticated - with no error pointing at it.
# AUTH_COOKIE_DOMAIN=.example.com

# --- Sessions ------------------------------------------------------------------
# A sign-in lasts 30 days after last use, never more than SESSION_MAX_AGE_DAYS
# from sign-in. The token is replaced daily; the replaced one works for
# SESSION_ROTATION_GRACE_SECONDS, after that it counts as copied and the
# session is revoked. SESSION_ALERTS_ENABLED=false stops the new sign-in and
# suspicious-activity emails.
# SESSION_MAX_AGE_DAYS=90
# SESSION_ROTATION_GRACE_SECONDS=120
# SESSION_ALERTS_ENABLED=true

# --- Secrets: required in production, the app refuses to boot without them ---
# Generate each with:  openssl rand -base64 32

# Chat message encryption at rest (AES-256-GCM). Optional in development;
# without it, messages are stored as plaintext and the app says so on boot.
# CHAT_ENCRYPTION_KEY=

# Rotation: keep old keys here so existing messages stay readable, and point
# CHAT_ENCRYPTION_KEY_VERSION at the one to encrypt new messages with.
# CHAT_ENCRYPTION_KEYS=1:<base64 key>,2:<base64 key>
# CHAT_ENCRYPTION_KEY_VERSION=2

# Keyed hash for the school join code students redeem to join as a student.
# Changing it invalidates every unredeemed code.
# STUDENT_CLAIM_CODE_PEPPER=

# --- Optional ---------------------------------------------------------------
# Cache and chat pub/sub. Without Redis both run in-process, which is fine for
# one instance and wrong for several - replicas would not see each other's
# invalidations or messages.
# USE_REDIS=true
# REDIS_URL=redis://localhost:6379

# Expo push access token (expo.dev → Account settings → Access tokens). Only
# needed when "Enhanced push security" is on for the Expo project; without it,
# pushes are sent unauthenticated, which Expo accepts otherwise.
# EXPO_ACCESS_TOKEN=

# Proxies in front of the API (1 = the bundled nginx). Rate limits key off the
# client address Fastify resolves through this many hops; add one per extra
# proxy (e.g. a CDN in front of nginx), or every client shares one bucket.
# TRUST_PROXY_HOPS=1

# Development only: treat school email domains as verified without the DNS
# TXT check, so a local stack can use made-up domains like demo.test. Ignored
# when NODE_ENV=production.
# ALLOW_UNVERIFIED_EMAIL_DOMAINS=true

# Development only: POST /auth/dev/code returns a sign-in code instead of
# mailing it, so local scripts (seed:demo, smoke) can sign in. Never set this
# on a shared or hosted deployment; ignored (404) when NODE_ENV=production.
ALLOW_DEV_LOGIN=true

# --- Single sign-on -----------------------------------------------------------
# The API speaks OpenID Connect and SAML itself. See docs/content/sso.md.
# SSO is set up per school: each school's admin (or an organisation admin)
# enters the school's own Google/Microsoft app under Single sign-on; secrets
# are encrypted with a key derived from AUTH_SECRET, bound to the school.
# These vars are an optional install-wide fallback, used only for schools
# that have not saved their own app for that provider (and for the login
# page's buttons before an email is typed). SAML needs nothing here: each
# school sets it up on its email domain. Set API_URL: redirect URIs are
# built from it.
# Env apps to offer (google, azure), only when their credentials are set too.
# SSO_PROVIDERS=google,azure
# Google Cloud OAuth client (Web application, External); authorised redirect
# URI: ${API_URL}/api/auth/sso/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration, multitenant, same redirect URI (Web).
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Our SAML entity ID, one for the whole install. Defaults to
# ${API_URL}/api/auth/sso/saml/metadata; the admin page shows the API's value.
# SAML_SP_ENTITY_ID=
# Where the mobile app picks up a finished sign-in (its URL scheme).
# MOBILE_SSO_RETURN_URL=gradebook://sso

# --- Mobile app updates (backend/src/app-version) ----------------------------
# GET /api/app/version tells the app which builds are current. Builds below the
# minimum get 426 Upgrade Required on every API call and a blocking "Update
# required" screen; builds below the latest are offered the update. Versions
# are MAJOR[.MINOR[.PATCH]] (the app's marketing version, e.g. 1.4.0); the
# _IOS / _ANDROID variants override the shared value for one platform. Unset =
# no requirement. A malformed value (or a non-https store URL) stops a
# production boot; development warns and ignores it.
# MOBILE_MIN_VERSION=1.0.0
# MOBILE_LATEST_VERSION=1.0.0
# MOBILE_MIN_VERSION_IOS=
# MOBILE_MIN_VERSION_ANDROID=
# MOBILE_LATEST_VERSION_IOS=
# MOBILE_LATEST_VERSION_ANDROID=
# MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id0000000000
# MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.example.gradebook

# --- Database (Prisma) --------------------------------------------------------
# Any Postgres 15+. Development: the `db` service in docker-compose.dev.yml.
# Create or update the schema with `bun run db:deploy` (or `bun run db:migrate`).
DATABASE_URL=postgresql://gradebook:gradebook@127.0.0.1:5432/gradebook

# --- Object storage (any S3-compatible store) --------------------------------
# Development: the `s3` service in docker-compose.dev.yml (SeaweedFS).
# Production: AWS S3 (omit S3_ENDPOINT), Cloudflare R2, Backblaze B2, ...
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=gradebook
S3_ACCESS_KEY_ID=gradebook
S3_SECRET_ACCESS_KEY=gradebook-secret
# The store's address as browsers and phones reach it, when that differs from
# S3_ENDPOINT (e.g. the API runs in a container, or a phone on the LAN needs
# http://<your-lan-ip>:8333). Presigned upload/download URLs are signed for it.
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# Optional public CDN / bucket host for avatars, course covers and school logos.
# Unset, their URLs point at this API's public routes /api/images/<area>/<file>
# (built from API_URL - set it when not on localhost, or covers/logos break).
# S3_PUBLIC_URL=
# Memory (MB) the API may hold at once while checking completed direct uploads
# (PDF, images, Office files). Beyond it, completions wait up to 10s, then 503.
# UPLOAD_VERIFY_MEMORY_MB=256
# Upload size limits, in whole MB (1-1024). UPLOAD_MAX_MB is the ceiling no
# school can exceed; UPLOAD_DEFAULT_MB is what a school gets until an admin
# sets its own limit (clamped to the ceiling). Malformed values stop a
# production boot.
# UPLOAD_MAX_MB=1024
# UPLOAD_DEFAULT_MB=100

# --- Email (any SMTP server) -------------------------------------------------
# Development: Mailpit from docker-compose.dev.yml (inbox: http://127.0.0.1:8025)
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="GradeBook <no-reply@gradebook.local>"
#
# Production: either one SMTP_URL (password URL-encoded), or separate fields
# (nothing to encode). SMTP_URL wins if both are set.
#
# Gmail / Google Workspace - turn on 2-Step Verification, then create an app
# password at https://myaccount.google.com/apppasswords. Paste it as shown;
# the spaces are removed for you.
# SMTP_SERVICE=gmail            # gmail | outlook | office365 | yahoo | icloud | zoho
# SMTP_USER=office@yourschool.edu
# SMTP_PASSWORD="abcd efgh ijkl mnop"
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password   # instead of SMTP_PASSWORD
#
# Any other server:
# SMTP_HOST=mail.yourschool.edu
# SMTP_PORT=587                 # 465 = implicit TLS, otherwise STARTTLS
# SMTP_SECURE=                  # force implicit TLS on/off (default: port 465)
# SMTP_ALLOW_INSECURE=false     # true allows sending credentials without TLS
#
# MAIL_FROM defaults to SMTP_USER. Gmail and Outlook only send as the signed-in
# account or a verified alias.

# --- Data retention and the erasure log (GDPR) -----------------------------
# Soft-deleted files, folders, chat messages and discussion posts are purged
# for good once they have been deleted this many days (a daily job in the
# API, one replica at a time). Per-kind overrides: *_FILES, *_FOLDERS,
# *_CHAT_MESSAGES, *_DISCUSSION_REPLIES. See backend/src/retention.
# RETENTION_PURGE_ENABLED=true
# SOFT_DELETE_RETENTION_DAYS=30
# SOFT_DELETE_RETENTION_DAYS_FILES=30
# RETENTION_PURGE_HOUR_UTC=3          # with a whole-day interval
# RETENTION_PURGE_INTERVAL_HOURS=24
# RETENTION_PURGE_BATCH_SIZE=500
# RETENTION_PURGE_MAX_MINUTES=10
# Every erasure is recorded (ids only) in compliance.erasure_log and copied to
# the app bucket under this prefix, so it survives a database restore; after a
# restore run `bun run erasure:replay --since <backup time>`. `off` disables
# the copy (not recommended). Keep entries longer than any backup can be
# restored from (default 400 days). See backend/src/erasure.
# ERASURE_LOG_S3_PREFIX=erasure-log
# ERASURE_LOG_RETENTION_DAYS=400

# --- Organisation -----------------------------------------------------------
# One organisation self-hosts this install and may run several schools. The
# first person to sign in names it (first-run setup) and becomes its admin;
# organisation admins create schools and appoint each school's admin.
# Accounts with a verified email listed here are organisation admins too, and
# while this is set only they may run the first-run setup (comma separated).
# ORG_ADMIN_EMAILS=it@example.org
