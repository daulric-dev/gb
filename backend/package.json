{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "student:check": "bun run scripts/student-flow-check.ts",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "smoke": "bun run scripts/smoke.ts",
    "erasure:replay": "bun run scripts/erasure-replay.ts",
    "retention:purge": "bun run scripts/retention-purge.ts",
    "db:pull": "prisma db pull && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "start": "nest start",
    "start:dev": "bunx cross-env NODE_ENV=development bun --watch src/main.ts",
    "start:debug": "bunx cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "bunx cross-env NODE_ENV=production bun src/main.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bun test src",
    "test:watch": "bun test src --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/s3-request-presigner": "3.1154.0",
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/swagger": "^9.8.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-fastify": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@node-saml/node-saml": "5.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "archiver": "^8.0.0",
    "bullmq": "^6.3.14",
    "class-transformer": "^0.5.1",
