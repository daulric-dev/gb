/// A school's webhook: platform events POSTed as signed JSON to a URL the
/// school chose (`/api/schools/current/webhooks`, or an organisation admin's
/// `/api/organisation/schools/:schoolId/webhooks`). Any http(s) URL is
/// allowed, internal addresses included: self-hosted schools call systems on
/// their own network. `events` holds explicit event type keys from
/// src/integrations/webhook-event-types.ts (never a wildcard). `secret_enc`
/// is the signing secret, AES-256-GCM under a key derived from AUTH_SECRET
/// and bound to the school and webhook id (src/integrations/webhook-secret.ts);
/// it is shown once, on create and on rotate. After WEBHOOK_MAX_CONSECUTIVE_FAILURES
/// failed deliveries in a row the webhook switches itself off
/// (`enabled` false, `disabled_reason` set) and the school's admins are emailed.
model school_webhook {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id            String             @db.Uuid
  name                 String
  url                  String
  secret_enc           String
  events               String[]           @default([])
  enabled              Boolean            @default(true)
  consecutive_failures Int                @default(0)
  disabled_reason      String?
  /// Who created it (no foreign key: the webhook outlives the account).
  created_by           String?            @db.Uuid
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @db.Timestamptz(6)
  school               school             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  webhook_delivery     webhook_delivery[]

  @@index([school_id, enabled], map: "school_webhook_school_enabled_idx")
  @@schema("public")
}

/// One event sent (or to be sent) to one webhook, with its retry state.
/// `payload` is the exact JSON body (it holds personal data: purged after
/// WEBHOOK_DELIVERY_RETENTION_DAYS by src/retention). `status`:
/// pending | succeeded | failed (a test or redelivery that did not succeed,
/// no retries) | abandoned (every retry used). `school_id` has no foreign key:
/// the row goes with its webhook.
model webhook_delivery {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id       String         @db.Uuid
  school_id        String         @db.Uuid
  event_id         String         @db.Uuid
  event_type       String
  payload          Json
  status           String         @default("pending")
  attempts         Int            @default(0)
  next_attempt_at  DateTime?      @default(now()) @db.Timestamptz(6)
  last_status_code Int?
  last_error       String?
  /// At most 1 KB of the last response body.
  response_excerpt String?
  duration_ms      Int?
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  delivered_at     DateTime?      @db.Timestamptz(6)
  webhook          school_webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, next_attempt_at], map: "webhook_delivery_due_idx")
  @@index([webhook_id, created_at(sort: Desc), id(sort: Desc)], map: "webhook_delivery_webhook_created_idx")
  @@index([created_at], map: "webhook_delivery_created_idx")
  @@schema("public")
}

/// One change to a school's webhooks (created, changed, deleted, secret
/// rotated, test sent, redelivered, auto-disabled), written in the same
/// transaction as the change. `webhook_id` and `actor_id` have no foreign key:
/// the entry outlives both. `changes` is `{ field: { before, after } }` plus
/// context and never holds a secret.
model integration_audit_log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id  String   @db.Uuid
  webhook_id String?  @db.Uuid
  webhook    String?
  actor_id   String?  @db.Uuid
  /// school_admin | organisation_admin | system
  actor_via  String
  /// webhook_created | webhook_updated | webhook_deleted | webhook_enabled | webhook_disabled | webhook_auto_disabled | secret_rotated | test_sent | delivery_redelivered
  action     String
  changes    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  school     school   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([school_id, created_at(sort: Desc), id(sort: Desc)], map: "integration_audit_log_school_created_idx")
  @@schema("public")
}
