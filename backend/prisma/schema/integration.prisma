/// A school's webhook: platform events POSTed as signed JSON to a URL the
/// school chose (`/api/schools/current/webhooks`, or an organisation admin's
/// `/api/organisation/schools/:schoolId/webhooks`). Any http(s) URL is
/// allowed, internal addresses included: self-hosted schools call systems on
/// their own network. `event_subscriptions` holds explicit event type keys
/// from src/integrations/webhook-event-types.ts (never a wildcard). `secret_enc`
/// is the signing secret, AES-256-GCM under a key derived from
/// DATA_ENCRYPTION_KEY (`v2:`) or, for `v1:` values, AUTH_SECRET
/// and bound to the school and webhook id (src/integrations/webhook-secret.ts);
/// it is shown once, on create and on rotate. After WEBHOOK_MAX_CONSECUTIVE_FAILURES
/// failed deliveries in a row the webhook switches itself off
/// (`enabled` false, `disabled_reason` set) and the school's admins are emailed.
model school_webhook {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id            String             @db.Uuid
  name                 String
  url                  String
  secret_enc           String
  enabled              Boolean            @default(true)
  consecutive_failures Int                @default(0)
  disabled_reason      String?
  /// Check the receiver's TLS certificate on https URLs (default). Off sends
  /// even to a server whose certificate can't be verified - deliveries can be
  /// intercepted - so turning it off is audited and alerted.
  verify_tls           Boolean            @default(true)
  /// PEM bundle of CA certificates to trust instead of the public roots (an
  /// internal server with a private-CA or self-signed certificate): the safe
  /// alternative to turning verification off. Public data, stored plain.
  tls_ca_cert          String?
  /// Who created it (no foreign key: the webhook outlives the account).
  created_by           String?            @db.Uuid
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @db.Timestamptz(6)
  school               school             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  webhook_delivery     webhook_delivery[]
  headers              school_webhook_header[]
  event_subscriptions  school_webhook_event[]

  @@index([school_id, enabled], map: "school_webhook_school_enabled_idx")
  @@schema("public")
}

/// One platform event type subscribed to by a webhook.
model school_webhook_event {
  webhook_id String         @db.Uuid
  event_type String
  webhook    school_webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([webhook_id, event_type])
  @@index([event_type, webhook_id], map: "school_webhook_event_type_idx")
  @@schema("public")
}

/// A custom header sent with every delivery of one webhook (up to 20 per
/// webhook), for receivers that expect a key: `Authorization: Bearer ...`,
/// `X-API-Key: ...`. `name` is an HTTP token (CHECK `^[A-Za-z0-9-]{1,100}$`;
/// reserved names are refused by the API). The migration adds a unique index
/// Prisma cannot express: one name per webhook ignoring case
/// (school_webhook_header_name_key on `(webhook_id, lower(name))`).
/// `value_enc` is the value, AES-256-GCM under its own key derived from
/// DATA_ENCRYPTION_KEY (`v2:`) or AUTH_SECRET (`v1:`), bound to the school, webhook and header id
/// (src/integrations/webhooks/webhook-secret.ts); never returned or audited.
/// Never drop that index when diffing: it lives in the migrations only.
model school_webhook_header {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id String         @db.Uuid
  name       String
  value_enc  String
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @default(now()) @db.Timestamptz(6)
  webhook    school_webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// One event sent (or to be sent) to one webhook, with its retry state.
/// `payload` is the exact JSON body (it holds personal data: purged after
/// WEBHOOK_DELIVERY_RETENTION_DAYS by src/retention). `status`:
/// pending | succeeded | failed (a test or redelivery that did not succeed,
/// no retries) | abandoned (every retry used). `school_id` has no foreign key:
/// the row goes with its webhook.
model webhook_delivery {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id       String         @db.Uuid
  school_id        String         @db.Uuid
  event_id         String         @db.Uuid
  event_type       String
  payload          Json
  status           String         @default("pending")
  attempts         Int            @default(0)
  next_attempt_at  DateTime?      @default(now()) @db.Timestamptz(6)
  last_status_code Int?
  last_error       String?
  /// At most 1 KB of the last response body.
  response_excerpt String?
  duration_ms      Int?
  /// Whether the last attempt checked the receiver's certificate: false when
  /// the webhook has verify_tls off, null for plain http (or not sent yet).
  tls_verified     Boolean?
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  delivered_at     DateTime?      @db.Timestamptz(6)
  webhook          school_webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, next_attempt_at], map: "webhook_delivery_due_idx")
  @@index([webhook_id, created_at(sort: Desc), id(sort: Desc)], map: "webhook_delivery_webhook_created_idx")
  @@index([created_at], map: "webhook_delivery_created_idx")
  @@schema("public")
}

/// One change to a school's webhooks (created, changed, deleted, secret
/// rotated, test sent, redelivered, auto-disabled), written in the same
/// transaction as the change. School, webhook and actor ids have no foreign
/// keys, so the entry survives deletion and is purged after the audit retention
/// period. `changes` is `{ field: { before, after } }` plus context and never
/// holds a secret.
model integration_audit_log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id  String   @db.Uuid
  webhook_id String?  @db.Uuid
  webhook    String?
  actor_id   String?  @db.Uuid
  /// school_admin | organisation_admin | system
  actor_via  String
  /// webhook_created | webhook_updated | webhook_deleted | webhook_enabled | webhook_disabled | webhook_auto_disabled | secret_rotated | test_sent | delivery_redelivered
  action     String
  changes    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([school_id, created_at(sort: Desc), id(sort: Desc)], map: "integration_audit_log_school_created_idx")
  @@schema("public")
}
