/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model file {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id    String         @db.Uuid
  owner_id     String         @db.Uuid
  name         String
  bucket       String         @default("file-manager")
  storage_path String
  content_type String         @default("application/octet-stream")
  size_bytes   BigInt         @default(0)
  source       file_source    @default(upload)
  source_ref   String?        @db.Uuid
  status       file_status    @default(pending)
  scan_detail  String?
  created_at   DateTime?      @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at   DateTime?      @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  deleted_at   DateTime?      @db.Timestamptz(6)
  folder_id    String?        @db.Uuid
  module_item  module_item[]
  folder       folder?        @relation(fields: [folder_id], references: [id], onUpdate: NoAction)
  user_profile user_profile   @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  school       school         @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file_share   file_share[]
  notification notification[]
  submission   submission[]

  @@index([owner_id, created_at(sort: Desc)], map: "idx_file_owner_active", where: raw("(deleted_at IS NULL)"))
  @@index([owner_id, folder_id], map: "idx_file_owner_folder", where: raw("(deleted_at IS NULL)"))
  @@index([school_id], map: "idx_file_school")
  @@schema("file_manager")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model file_share {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id        String          @db.Uuid
  school_id      String          @db.Uuid
  principal_type share_principal
  principal_id   String          @db.Uuid
  can_download   Boolean         @default(false)
  created_by     String?         @db.Uuid
  created_at     DateTime?       @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  user_profile   user_profile?   @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  file           file            @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  school         school          @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([file_id, principal_type, principal_id], map: "file_share_unique_principal")
  @@index([file_id], map: "idx_file_share_file")
  @@index([principal_type, principal_id], map: "idx_file_share_principal")
  @@schema("file_manager")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model folder {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id    String       @db.Uuid
  owner_id     String       @db.Uuid
  parent_id    String?      @db.Uuid
  name         String
  is_system    Boolean      @default(false)
  created_at   DateTime?    @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at   DateTime?    @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)
  file         file[]
  user_profile user_profile @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folder       folder?      @relation("folderTofolder", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_folder folder[]     @relation("folderTofolder")
  school       school       @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([owner_id, parent_id, name], map: "idx_folder_unique_child", where: raw("((parent_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@unique([owner_id, name], map: "idx_folder_unique_root", where: raw("((parent_id IS NULL) AND (deleted_at IS NULL))"))
  @@index([owner_id, parent_id], map: "idx_folder_owner_parent", where: raw("(deleted_at IS NULL)"))
  @@schema("file_manager")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notification {
  id           String       @id(map: "file_notification_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id    String       @db.Uuid
  user_id      String       @db.Uuid
  file_id      String?      @db.Uuid
  share_id     String?      @db.Uuid
  type         String       @default("file_share")
  title        String
  body         String?
  can_download Boolean      @default(false)
  read_at      DateTime?    @db.Timestamptz(6)
  created_at   DateTime?    @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  file         file?        @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "file_notification_file_id_fkey")
  school       school       @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "file_notification_school_id_fkey")
  user_profile user_profile @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "file_notification_user_id_fkey")

  @@unique([user_id, share_id], map: "file_notification_unique_recipient_share")
  @@index([user_id, created_at(sort: Desc)], map: "idx_file_notification_unread", where: raw("(read_at IS NULL)"))
  @@index([user_id, created_at(sort: Desc)], map: "idx_file_notification_user")
  @@schema("file_manager")
}

enum file_source {
  report
  upload

  @@schema("file_manager")
}

enum file_status {
  pending
  scanning
  ready
  failed
  infected

  @@schema("file_manager")
}

enum share_principal {
  user
  role
  group
  course

  @@schema("file_manager")
}
