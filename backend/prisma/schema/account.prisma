/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model app_user {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @unique
  email_verified_at DateTime?     @db.Timestamptz(6)
  disabled_at       DateTime?     @db.Timestamptz(6)
  last_sign_in_at   DateTime?     @db.Timestamptz(6)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @db.Timestamptz(6)
  identity          identity[]
  session           session[]
  user_profile      user_profile?

  @@schema("account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model email_code {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  code_hash   String
  expires_at  DateTime  @db.Timestamptz(6)
  attempts    Int       @default(0)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email, created_at(sort: Desc)], map: "email_code_email_idx")
  @@schema("account")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model identity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  provider     String
  subject      String
  email        String?
  claims       Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  last_used_at DateTime @default(now()) @db.Timestamptz(6)
  app_user     app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, subject])
  @@index([user_id])
  @@schema("account")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique
  expires_at   DateTime  @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  user_agent   String?
  ip           String?
  method       String
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  app_user     app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
  @@index([user_id])
  @@schema("account")
}
