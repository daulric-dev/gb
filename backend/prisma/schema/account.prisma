/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model app_user {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @unique
  email_verified_at DateTime?     @db.Timestamptz(6)
  disabled_at       DateTime?     @db.Timestamptz(6)
  last_sign_in_at   DateTime?     @db.Timestamptz(6)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @db.Timestamptz(6)
  identity          identity[]
  session           session[]
  known_device      known_device[]
  user_profile      user_profile?
  invoice           invoice[]
  platform_admin    platform_admin?

  @@schema("account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model email_code {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  code_hash   String
  expires_at  DateTime  @db.Timestamptz(6)
  attempts    Int       @default(0)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  /// Keyed hash of the client address that asked for the code (per-client send cap).
  ip_hash     String?
  email_code_attempt email_code_attempt[]

  @@index([email, created_at(sort: Desc)], map: "email_code_email_idx")
  @@schema("account")
}

/// Wrong guesses at a sign-in code per client address; email_code.attempts is the total.
model email_code_attempt {
  code_id    String     @db.Uuid
  ip_hash    String
  attempts   Int        @default(0)
  email_code email_code @relation(fields: [code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([code_id, ip_hash])
  @@schema("account")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model identity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  provider     String
  subject      String
  email        String?
  claims       Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  last_used_at DateTime @default(now()) @db.Timestamptz(6)
  app_user     app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, subject])
  @@index([user_id])
  @@schema("account")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  token_hash          String    @unique
  expires_at          DateTime  @db.Timestamptz(6)
  last_seen_at        DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at          DateTime? @db.Timestamptz(6)
  user_agent          String?
  ip                  String?
  method              String
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  /// Never extended: SESSION_MAX_AGE_DAYS after sign-in.
  absolute_expires_at DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '90 days'::interval)")) @db.Timestamptz(6)
  /// The token replaced at the last rotation; accepted only during the grace period.
  previous_token_hash String?   @unique
  rotated_at          DateTime? @db.Timestamptz(6)
  /// When the token issued at the last rotation was first presented. Until then the replaced token can recover the session from the same client for a day.
  rotation_confirmed_at DateTime? @db.Timestamptz(6)
  revoked_reason      String?
  device              String?
  app_user            app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
  @@index([user_id])
  @@index([user_id, created_at(sort: Desc)], map: "session_user_id_live_idx", where: raw("(revoked_at IS NULL)"))
  @@schema("account")
}

/// Devices a user signed in on (hashed method + device label), for new sign-in alerts.
model known_device {
  user_id       String   @db.Uuid
  fingerprint   String
  first_seen_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime @default(now()) @db.Timestamptz(6)
  app_user      app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, fingerprint])
  @@index([last_seen_at])
  @@schema("account")
}
