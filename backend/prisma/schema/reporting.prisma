/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model class_report_file {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_group_id String        @db.Uuid
  term_id          String        @db.Uuid
  report_type      String
  file_type        String
  file_path        String
  file_size        Int
  generated_by     String?       @db.Uuid
  generated_at     DateTime?     @default(now()) @db.Timestamptz(6)
  user_profile     user_profile? @relation(fields: [generated_by], references: [id], onUpdate: NoAction)
  student_group    student_group @relation(fields: [student_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  term             term          @relation(fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([student_group_id, term_id], map: "idx_class_report_file_group_term")
  @@index([term_id], map: "idx_class_report_file_term")
  @@schema("reporting")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model report_book {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String?             @db.Uuid
  term_id           String?             @db.Uuid
  academic_year_id  String?             @db.Uuid
  report_type       report_book_type?
  status            report_book_status?
  general_remarks   String?
  conduct_grade     String?
  attendance_days   Int?                @db.SmallInt
  total_school_days Int?                @db.SmallInt
  created_by        String?             @db.Uuid
  generated_at      DateTime?           @db.Timestamptz(6)
  published_at      DateTime?           @db.Timestamptz(6)
  student_group_id  String?             @db.Uuid
  position          BigInt?
  overall_average   Decimal?            @db.Decimal
  total_students    BigInt?
  academic_year     academic_year?      @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile      user_profile?       @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  student_group     student_group?      @relation(fields: [student_group_id], references: [id], onUpdate: NoAction)
  student           student?            @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  term              term?               @relation(fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  report_book_entry report_book_entry[]
  report_book_pdf   report_book_pdf[]

  @@unique([student_id, term_id, report_type], map: "report_book_student_term_type_key")
  @@index([student_group_id], map: "idx_report_book_student_group")
  @@index([term_id], map: "idx_report_book_term")
  @@index([academic_year_id], map: "idx_report_book_year")
  @@schema("reporting")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model report_book_entry {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_book_id     String?      @db.Uuid
  subject_id         String?      @db.Uuid
  term_average       Decimal?     @db.Decimal
  letter_grade       String?
  teacher_remark     String?
  is_graded          Boolean?     @default(false)
  coursework_average Decimal?     @db.Decimal
  exam_average       Decimal?     @db.Decimal
  sort_order         BigInt?
  term_composite     Decimal?     @db.Decimal
  year_grade         Decimal?     @db.Decimal
  term_grade         Decimal?     @db.Decimal
  group_breakdown    Json?
  report_book        report_book? @relation(fields: [report_book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subject            subject?     @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([report_book_id, subject_id], map: "report_book_entry_book_subject_key")
  @@index([subject_id], map: "idx_report_book_entry_subject")
  @@index([report_book_id], map: "idx_report_entry_book")
  @@schema("reporting")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model report_book_pdf {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_book_id String        @db.Uuid
  file_path      String
  file_size      Int?
  generated_by   String?       @db.Uuid
  generated_at   DateTime      @default(now()) @db.Timestamptz(6)
  user_profile   user_profile? @relation(fields: [generated_by], references: [id], onUpdate: NoAction)
  report_book    report_book   @relation(fields: [report_book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([report_book_id], map: "idx_report_book_pdf_report_book")
  @@schema("reporting")
}
