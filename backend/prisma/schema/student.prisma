/// A parent or guardian's link to a student (see src/parent-portal). Made by redeeming a parent_invite; staff list and remove links. One link per parent and student.
model parent_student_link {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_profile_id String             @db.Uuid
  student_id      String             @db.Uuid
  relationship    relationship_type?
  /// Free-text label shown to staff ("Grandmother", "Carer"); up to 60 characters.
  relationship_label String?
  /// Staff member who sent the invite or code that made this link; no foreign key (the link outlives them).
  created_by      String?            @db.Uuid
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  student         student            @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile    user_profile       @relation(fields: [user_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_profile_id, student_id], map: "parent_student_link_parent_student_key")
  @@index([student_id], map: "idx_parent_link_student")
  @@index([user_profile_id], map: "idx_parent_link_user_profile")
  @@schema("student")
}

/// An invitation that links a parent to a student when redeemed: an emailed link (kind `email`, bound to `email`) or a one-time code staff hand over (kind `code`). Only the SHA-256 of the token is stored; single use (`used_at`), expiring, revocable.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parent_invite {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id         String             @db.Uuid
  school_id          String             @db.Uuid
  kind               String
  email              String?
  token_hash         String             @unique(map: "parent_invite_token_hash_key")
  relationship       relationship_type?
  relationship_label String?
  expires_at         DateTime           @db.Timestamptz(6)
  used_at            DateTime?          @db.Timestamptz(6)
  used_by            String?            @db.Uuid
  revoked_at         DateTime?          @db.Timestamptz(6)
  created_by         String?            @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  student            student            @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([student_id, created_at(sort: Desc)], map: "idx_parent_invite_student")
  @@schema("student")
}

/// A parent's notification choices: email and push are each opt-in (off until the parent turns them on).
model parent_notification_pref {
  user_profile_id String       @id @db.Uuid
  email_enabled   Boolean      @default(false)
  push_enabled    Boolean      @default(false)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  user_profile    user_profile @relation(fields: [user_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kind_preferences parent_notification_kind[]

  @@schema("student")
}

/// A notice category a parent has chosen to receive.
model parent_notification_kind {
  user_profile_id String                   @db.Uuid
  kind            String
  preference      parent_notification_pref @relation(fields: [user_profile_id], references: [user_profile_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_profile_id, kind])
  @@schema("student")
}

/// One row per notice sent to a parent (kind + the row it is about), so each event notifies a parent once across ticks and instances.
model parent_notification_sent {
  user_profile_id String       @db.Uuid
  kind            String
  ref_id          String       @db.Uuid
  sent_at         DateTime     @default(now()) @db.Timestamptz(6)
  user_profile    user_profile @relation(fields: [user_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_profile_id, kind, ref_id])
  @@index([sent_at], map: "idx_parent_notification_sent_at")
  @@schema("student")
}

model school_join_code {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id    String        @unique(map: "idx_school_join_code_one_active", where: raw("(revoked_at IS NULL)")) @db.Uuid
  code_hash    String
  expires_at   DateTime      @db.Timestamptz(6)
  revoked_at   DateTime?     @db.Timestamptz(6)
  created_by   String?       @db.Uuid
  created_at   DateTime      @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  user_profile user_profile? @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  school       school        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code_hash], map: "idx_school_join_code_hash")
  @@schema("student")
}

model student {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String?                    @db.Uuid
  first_name          String?
  last_name           String?
  date_of_birth       DateTime?                  @db.Date
  gender              String?
  enrollment_date     DateTime?                  @db.Date
  is_active           Boolean?                   @default(true)
  user_profile_id     String?                    @unique(map: "idx_student_user_profile_unique", where: raw("(user_profile_id IS NOT NULL)")) @db.Uuid
  /// The school's own student number (SIS identifier), set by rostering (src/rostering); unique per school when present.
  student_number      String?
  /// The student's form tutor (a staff user_profile of the school; no foreign key, membership is checked when used). Receives attendance alerts (src/attendance-alerts).
  form_tutor_id       String?                    @db.Uuid
  /// When is_active last became false (set by the trigger student_set_left_at; null while active). Starts the school's leaver retention period (src/retention).
  left_at             DateTime?                  @db.Timestamptz(6)
  attendance_alert    attendance_alert[]
  attendance_record   course_attendance_record[]
  course_student      course_student[]
  submission          submission[]
  activity_extension  activity_extension[]
  activity_accommodation activity_accommodation[]
  student_accommodation  student_accommodation?
  peer_review_allocation peer_review_allocation[]
  parent_student_link parent_student_link[]
  report_comment      report_comment[]
  report_head_comment report_head_comment[]
  report_document     report_document[]
  parent_invite       parent_invite[]
  pastoral_note       pastoral_note[]
  analytics_at_risk   analytics_at_risk[]
  school              school?                    @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile        user_profile?              @relation(fields: [user_profile_id], references: [id], onUpdate: NoAction)

  outcome_evidence    outcome_evidence[]
  @@index([first_name(ops: raw("gin_trgm_ops"))], map: "idx_student_first_name_trgm", type: Gin)
  @@index([last_name(ops: raw("gin_trgm_ops"))], map: "idx_student_last_name_trgm", type: Gin)
  @@unique([school_id, student_number], map: "student_school_number_key", where: raw("(student_number IS NOT NULL)"))
  @@index([school_id], map: "idx_student_school")
  @@index([form_tutor_id], map: "idx_student_form_tutor")
  @@schema("student")
}
