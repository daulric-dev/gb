/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model parent_student_link {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_profile_id String?            @db.Uuid
  student_id      String?            @db.Uuid
  relationship    relationship_type?
  student         student?           @relation(fields: [student_id], references: [id], onUpdate: NoAction)
  user_profile    user_profile?      @relation(fields: [user_profile_id], references: [id], onUpdate: NoAction)

  @@index([student_id], map: "idx_parent_link_student")
  @@index([user_profile_id], map: "idx_parent_link_user_profile")
  @@schema("student")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model school_join_code {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id    String        @unique(map: "idx_school_join_code_one_active", where: raw("(revoked_at IS NULL)")) @db.Uuid
  code_hash    String
  expires_at   DateTime      @db.Timestamptz(6)
  revoked_at   DateTime?     @db.Timestamptz(6)
  created_by   String?       @db.Uuid
  created_at   DateTime      @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  user_profile user_profile? @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  school       school        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code_hash], map: "idx_school_join_code_hash")
  @@schema("student")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model student {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id           String?                    @db.Uuid
  first_name          String?
  last_name           String?
  date_of_birth       DateTime?                  @db.Date
  gender              String?
  enrollment_date     DateTime?                  @db.Date
  is_active           Boolean?                   @default(true)
  user_profile_id     String?                    @unique(map: "idx_student_user_profile_unique", where: raw("(user_profile_id IS NOT NULL)")) @db.Uuid
  attendance_record   course_attendance_record[]
  course_student      course_student[]
  submission          submission[]
  parent_student_link parent_student_link[]
  school              school?                    @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile        user_profile?              @relation(fields: [user_profile_id], references: [id], onUpdate: NoAction)

  @@index([first_name(ops: raw("gin_trgm_ops"))], map: "idx_student_first_name_trgm", type: Gin)
  @@index([last_name(ops: raw("gin_trgm_ops"))], map: "idx_student_last_name_trgm", type: Gin)
  @@index([school_id], map: "idx_student_school")
  @@schema("student")
}
