/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model student_attendance_record {
  id                                                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id                                              String                   @db.Uuid
  student_group_id                                        String                   @db.Uuid
  attendance_date                                         DateTime                 @db.Date
  status                                                  public_attendance_status
  notes                                                   String?
  created_by                                              String?                  @db.Uuid
  updated_by                                              String?                  @db.Uuid
  created_at                                              DateTime?                @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at                                              DateTime?                @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  user_profile_attendance_record_created_byTouser_profile user_profile?            @relation("attendance_record_created_byTouser_profile", fields: [created_by], references: [id], onUpdate: NoAction)
  student_group                                           student_group            @relation(fields: [student_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student                                                 student                  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile_attendance_record_updated_byTouser_profile user_profile?            @relation("attendance_record_updated_byTouser_profile", fields: [updated_by], references: [id], onUpdate: NoAction)

  @@unique([student_id, student_group_id, attendance_date], map: "attendance_record_student_group_date_unique")
  @@index([student_group_id, attendance_date], map: "idx_attendance_group_date")
  @@index([student_id, attendance_date], map: "idx_attendance_student_date")
  @@map("attendance_record")
  @@schema("student")
}

