/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model discussion_topic {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id              String                @db.Uuid
  author_user_profile_id String?               @db.Uuid
  title                  String
  body                   String                @default("")
  is_pinned              Boolean               @default(false)
  is_locked              Boolean               @default(false)
  is_published           Boolean               @default(true)
  require_initial_post   Boolean               @default(false)
  last_reply_at          DateTime?             @db.Timestamptz(6)
  edited_at              DateTime?             @db.Timestamptz(6)
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  course                 course                @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile           user_profile?         @relation(fields: [author_user_profile_id], references: [id], onUpdate: NoAction)
  discussion_reply       discussion_reply[]
  discussion_read        discussion_read[]
  module_item            module_item[]
  course_notification    course_notification[]

  @@index([course_id, is_pinned(sort: Desc), created_at(sort: Desc)], map: "discussion_topic_course_idx")
  @@index([author_user_profile_id])
  @@schema("course")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model discussion_reply {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic_id               String             @db.Uuid
  course_id              String             @db.Uuid
  parent_id              String?            @db.Uuid
  author_user_profile_id String?            @db.Uuid
  body                   String
  edited_at              DateTime?          @db.Timestamptz(6)
  deleted_at             DateTime?          @db.Timestamptz(6)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  course                 course             @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent                 discussion_reply?  @relation("discussion_reply_parent", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children               discussion_reply[] @relation("discussion_reply_parent")
  discussion_topic       discussion_topic   @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile           user_profile?      @relation(fields: [author_user_profile_id], references: [id], onUpdate: NoAction)

  @@index([topic_id, created_at], map: "discussion_reply_topic_idx")
  @@index([course_id])
  @@index([parent_id])
  @@index([author_user_profile_id])
  @@schema("course")
}

model discussion_read {
  topic_id         String           @db.Uuid
  user_profile_id  String           @db.Uuid
  last_read_at     DateTime         @default(now()) @db.Timestamptz(6)
  discussion_topic discussion_topic @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile     user_profile     @relation(fields: [user_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([topic_id, user_profile_id])
  @@index([user_profile_id])
  @@schema("course")
}

model discussion_setting {
  course_id                  String   @id @db.Uuid
  students_can_create_topics Boolean  @default(false)
  updated_at                 DateTime @default(now()) @db.Timestamptz(6)
  course                     course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("course")
}
