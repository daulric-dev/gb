// Behaviour and pastoral notes (src/pastoral), behind the `pastoral_notes`
// feature. Migration 20261128100000_pastoral_notes. Private staff notes about
// a student; never read by the student portal, parent portal, report cards,
// webhooks or LTI. Personal data: deleted with the student (cascade), purged
// after the school's retention period once resolved, and every erasure is
// written to compliance.erasure_log.

/// A school's note categories. `kind` is the built-in type the category
/// belongs to; `is_safeguarding` makes its notes need the
/// `pastoral-note:safeguarding` permission. Archived categories keep their
/// notes but take no new ones.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pastoral_category {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id       String          @db.Uuid
  label           String
  kind            String
  is_safeguarding Boolean         @default(false)
  position        Int             @default(0)
  archived_at     DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  school          school          @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notes           pastoral_note[]

  @@unique([school_id, label], map: "pastoral_category_school_label_key")
  @@schema("student")
}

/// One staff note about a student. `is_safeguarding` is copied from the
/// category when the note is written (and kept in step when the category
/// changes) so every visibility filter is a plain column test.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pastoral_note {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id       String               @db.Uuid
  student_id      String               @db.Uuid
  category_id     String               @db.Uuid
  is_safeguarding Boolean              @default(false)
  severity        String               @default("low")
  occurred_on     DateTime             @db.Date
  body            String
  follow_up_on    DateTime?            @db.Date
  assigned_to     String?              @db.Uuid
  status          String               @default("open")
  resolved_at     DateTime?            @db.Timestamptz(6)
  /// Staff member who resolved it; no foreign key (kept after they leave).
  resolved_by     String?              @db.Uuid
  author_id       String?              @db.Uuid
  created_at      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at      DateTime             @default(now()) @db.Timestamptz(6)
  school          school               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student         student              @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category        pastoral_category    @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  author          user_profile?        @relation("pastoral_note_author", fields: [author_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignee        user_profile?        @relation("pastoral_note_assignee", fields: [assigned_to], references: [id], onDelete: SetNull, onUpdate: NoAction)
  files           pastoral_note_file[]

  @@index([student_id, occurred_on(sort: Desc)], map: "idx_pastoral_note_student")
  @@index([school_id, occurred_on(sort: Desc)], map: "idx_pastoral_note_school")
  @@index([assigned_to, follow_up_on], map: "idx_pastoral_note_follow_up", where: raw("(status = 'open'::text)"))
  @@index([author_id])
  @@index([category_id])
  @@index([school_id, resolved_at], map: "idx_pastoral_note_resolved", where: raw("(status = 'resolved'::text)"))
  @@schema("student")
}

/// A file from the author's file manager attached to a note. Served only
/// through the note (the same visibility rules).
model pastoral_note_file {
  note_id    String        @db.Uuid
  file_id    String        @db.Uuid
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  note       pastoral_note @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file       file          @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([note_id, file_id])
  @@index([file_id])
  @@schema("student")
}

/// Per-school pastoral settings. `retention_days`: resolved notes are purged
/// this many days after they were resolved; null keeps them until the
/// student is removed.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pastoral_setting {
  school_id      String   @id @db.Uuid
  retention_days Int?
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  school         school   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("student")
}
