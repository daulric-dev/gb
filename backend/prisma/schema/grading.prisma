/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model activity {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                  activity_kind
  title                 String
  instructions          String?
  points                Decimal           @default(100) @db.Decimal
  due_at                DateTime?         @db.Timestamptz(6)
  status                activity_status   @default(draft)
  published_at          DateTime?         @db.Timestamptz(6)
  allow_file            Boolean           @default(false)
  allow_multiple_files  Boolean           @default(false)
  allow_text            Boolean           @default(false)
  created_by            String?           @db.Uuid
  created_at            DateTime          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at            DateTime          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  max_attempts          Int?              @default(1)
  time_limit_minutes    Int?
  lockdown_browser      Boolean           @default(false)
  course_id             String            @db.Uuid
  assignment_group_id   String?           @db.Uuid
  omit_from_final_grade Boolean           @default(false)
  rubric_id             String?           @db.Uuid
  /// Late work is accepted until then (after due_at); null closes at due_at.
  late_until            DateTime?         @db.Timestamptz(6)
  late_penalty_mode     late_penalty_mode @default(none)
  /// Percent per started day or hour late.
  late_penalty_value    Decimal?          @db.Decimal(5, 2)
  /// The most a late penalty can take, in percent.
  late_penalty_cap      Decimal?          @db.Decimal(5, 2)
  rubric                rubric?           @relation(fields: [rubric_id], references: [id], onUpdate: NoAction)
  module_item           module_item[]
  assignment_group      assignment_group? @relation(fields: [assignment_group_id], references: [id], onUpdate: NoAction)
  course                course            @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile          user_profile?     @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  quiz_question         quiz_question[]
  submission            submission[]
  course_notification   course_notification[]
  activity_extension    activity_extension[]
  activity_accommodation activity_accommodation[]
  /// Shuffle each student's question order / option order.
  shuffle_questions     Boolean           @default(false)
  shuffle_options       Boolean           @default(false)
  quiz_bank_draw        quiz_bank_draw[]
  lti_line_item          lti_line_item?

  @@index([assignment_group_id])
  @@index([course_id])
  @@index([status], map: "idx_activity_status")
  @@index([rubric_id], map: "idx_activity_rubric")
  @@schema("grading")
}

