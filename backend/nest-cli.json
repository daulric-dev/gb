{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      "@nestjs/swagger"
    ],
    "assets": [
      {
        "include": "**/*.lua",
        "outDir": "dist"
      },
      {
        "include": "report-card/fonts/*.{ttf,otf,txt,md}",
        "outDir": "dist"
      }
    ]
  }
}
