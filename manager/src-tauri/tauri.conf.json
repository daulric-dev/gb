{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gradebook Manager",
  "mainBinaryName": "gradebook-manager",
  "version": "0.1.1",
  "identifier": "com.gradebook.manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gradebook Manager",
        "width": 1140,
        "height": 760,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
