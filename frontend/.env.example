# Copy to `.env.local` for local development. Never commit `.env.local`.

# Backend API (no `/api` suffix - `lib/api.ts` adds it)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Object storage origin that browsers upload to with presigned URLs - the origin
# of the backend's S3_PUBLIC_ENDPOINT (or S3_ENDPOINT when that is unset).
# Allowed in the production CSP (connect-src, img-src); uploads are blocked
# without it. Only the origin is used.
#   Dev (SeaweedFS):  http://127.0.0.1:8333
#   Prod (R2):        https://<account-id>.r2.cloudflarestorage.com
# NEXT_PUBLIC_STORAGE_URL=http://127.0.0.1:8333
