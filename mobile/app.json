{
  "expo": {
    "name": "GradeBook",
    "slug": "gradebook-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gradebook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.daulric.gradebook"
    },
    "android": {
      "package": "dev.daulric.gradebook"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GradeBook to access your photos to set a profile picture."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#171717"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GradeBook uses your location only to check you in to class when your teacher asks."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GradeBook uses the camera to scan your class attendance QR code.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
