# Where the app finds the backend. No `/api` suffix - lib/api.ts adds it.
#
# Development: leave unset. The API host is taken from the Expo dev server the
# app loaded from, so it follows this machine's address automatically and
# survives a new DHCP lease.
#
# Production: REQUIRED. A release build has no dev server to ask, so the build
# fails fast rather than shipping an app that silently talks to localhost.
# Must be HTTPS - iOS App Transport Security allows cleartext only on the
# local network.
#
# EXPO_PUBLIC_API_URL=https://api.example.com
